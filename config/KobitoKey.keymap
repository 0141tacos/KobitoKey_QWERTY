#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_shift {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&kp LEFT_SHIFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer_mac {
            bindings = <
&kp Q                &kp L  &kp U        &kp COMMA      &kp PERIOD          &kp F                  &kp W        &kp R              &kp Y  &kp P
&kp E                &kp I  &kp A        &kp O          &kp MINUS           &kp K                  &kp T        &kp N              &kp S  &kp H
&kp Z                &kp X  &kp C        &kp V          &mt LEFT_SHIFT TAB  &kp G                  &kp D        &kp M              &kp J  &kp B
&mt LEFT_ALT ESCAPE  &none  &lt 3 ENTER  &kp BACKSPACE  &mt LEFT_GUI LANG2  &mt RIGHT_SHIFT LANG1  &lt 2 SPACE  &kp RIGHT_CONTROL  &none  &kp ESCAPE
            >;
        };

        default_layer_windows {
            bindings = <
&kp Q                &kp L  &kp U        &kp COMMA      &kp PERIOD              &kp F                  &kp W        &kp R         &kp Y  &kp P
&kp E                &kp I  &kp A        &kp O          &kp MINUS               &kp K                  &kp T        &kp N         &kp S  &kp H
&kp Z                &kp X  &kp C        &kp V          &mt LEFT_SHIFT TAB      &kp G                  &kp D        &kp M         &kp J  &kp B
&mt LEFT_GUI ESCAPE  &none  &lt 3 ENTER  &kp BACKSPACE  &mt LEFT_CONTROL LANG2  &mt RIGHT_SHIFT LANG1  &lt 2 SPACE  &kp LEFT_ALT  &none  &kp ESCAPE
            >;
        };

        ARROW {
            label = "ARROW";
            bindings = <
&kp EQUAL  &kp RIGHT_BRACKET        &kp LS(N2)  &kp BACKSLASH         &kp LEFT_BRACKET  &none               &kp LG(LEFT_ARROW)  &kp UP_ARROW      &kp LG(RIGHT_ARROW)  &none
&kp INT1   &kp LS(N8)               &kp LS(N7)  &kp LS(N9)            &kp LS(N3)        &kp LS(LEFT_ARROW)  &kp LEFT_ARROW      &kp DOWN_ARROW    &kp RIGHT_ARROW      &kp RS(RIGHT_ARROW)
&kp LS(EQUAL)  &kp LS(RIGHT_BRACKET)  &kp LS(LEFT_BRACKET)  &kp LS(BACKSLASH)  &kp LS(N4)  &none               &kp LA(LEFT_ARROW)  &kp LC(UP_ARROW)  &kp LA(RIGHT_ARROW)  &none
&to 1          &none                 &kp LEFT_ALT       &kp DELETE             &kp LEFT_GUI  &none               &none               &none             &trans               &trans
            >;
        };

        NUMBER {
            label = "number";
            bindings = <
&kp SQT          &kp N7  &kp N8  &kp N9  &none      &kp AMPERSAND    &kp LESS_THAN     &kp LS(SEMI)     &kp LS(SQT)  &kp SQT
&kp N0           &kp N4  &kp N5  &kp N6  &trans     &kp EXCLAMATION  &kp LS(MINUS)     &kp MINUS       &kp FSLH     &kp SEMI
&kp LS(INT1)     &kp N1  &kp N2  &kp N3  &kp SLASH  &kp LS(INT3)     &kp GREATER_THAN  &kp LS(INT1)    &kp PERCENT  &kp QUESTION
&trans          &trans  &trans  &trans  &trans     &trans           &trans            &trans          &trans        &to 0
            >;
        };

        MOUSE {
            label = "mouse";
            bindings = <
&trans  &trans  &kp LEFT_CONTROL  &kp LEFT_GUI   &kp LEFT_SHIFT  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
&trans  &trans  &trans            &kp LG(MINUS)  &kp LG(PLUS)    &mkp MB4  &mkp MB5  &trans    &trans  &trans
&trans  &trans  &trans            &trans         &trans          &trans    &trans    &trans    &trans  &trans
&trans  &trans  &trans            &trans         &trans          &trans    &trans    &trans    &trans  &trans
            >;
        };

        BTandFUNCTION {
            bindings = <
&kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &trans         &trans         &trans         &bt BT_CLR
&kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3
&kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_SEL 3
&trans  &trans   &trans   &trans   &trans  &trans  &trans         &trans         &trans         &trans
            >;

            label = "BT&FUNCTION";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        BTandFUNCTION {
            if-layers = <2 3>;
            then-layer = <5>;
        };
    };
};
