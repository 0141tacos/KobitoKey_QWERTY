#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <12 11>;
            bindings = <&kp ESC>;
        };

        combo_shift {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&kp LEFT_SHIFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer_mac {
            bindings = <
&kp Q         &kp L  &kp U        &kp COMMA      &kp PERIOD          &kp F            &kp W        &kp R              &kp Y  &kp P
&kp E         &kp I  &kp A        &kp O          &kp MINUS           &kp K            &kp T        &kp N              &kp S  &kp H
&kp Z         &kp X  &kp C        &kp V          &mt LEFT_SHIFT TAB  &kp G            &kp D        &kp M              &kp J  &kp B
&kp LEFT_ALT  &to 1  &lt 3 ENTER  &kp BACKSPACE  &kp LEFT_GUI        &kp RIGHT_SHIFT  &lt 2 SPACE  &kp RIGHT_CONTROL  &to 0  &kp ESCAPE
            >;
        };

        default_layer_windows {
            bindings = <
&kp Q         &kp L  &kp U        &kp COMMA      &kp PERIOD          &kp F            &kp W        &kp R             &kp Y  &kp P
&kp E         &kp I  &kp A        &kp O          &kp MINUS           &kp K            &kp T        &kp N             &kp S  &kp H
&kp Z         &kp X  &kp C        &kp V          &mt LEFT_SHIFT TAB  &kp G            &kp D        &kp M             &kp J  &kp B
&kp LEFT_ALT  &to 1  &lt 3 ENTER  &kp BACKSPACE  &kp LEFT_CONTROL    &kp RIGHT_SHIFT  &lt 2 SPACE  &kp LEFT_COMMAND  &to 0  &kp ESCAPE
            >;
        };

        ARROW {
            label = "ARROW";
            bindings = <
&kp CARET             &kp LEFT_BRACKET      &kp DOUBLE_QUOTES  &kp RIGHT_BRACKET      &kp AT_SIGN   &none  &kp LG(LEFT_ARROW)  &kp UP_ARROW      &kp LG(RIGHT_ARROW)  &none
&kp NON_US_BACKSLASH  &kp LEFT_PARENTHESIS  &kp SQT            &kp RIGHT_PARENTHESIS  &kp HASH      &none  &kp LEFT_ARROW      &kp DOWN_ARROW    &kp RIGHT_ARROW      &none
&kp TILDE             &kp LEFT_BRACE        &kp GRAVE          &kp RIGHT_BRACE        &kp DOLLAR    &none  &kp LA(LEFT_ARROW)  &kp LC(UP_ARROW)  &kp LA(RIGHT_ARROW)  &none
&kp LSHFT             &none                 &none              &kp DELETE             &kp LEFT_GUI  &none  &none               &none             &to 0                &kp RALT
            >;
        };

        NUMBER {
            label = "number";
            bindings = <
&kp COLON       &kp N7  &kp N8  &kp N9  &none      &kp AMPERSAND    &kp LESS_THAN     &kp PLUS        &kp ASTERISK  &kp COLON
&kp N0          &kp N4  &kp N5  &kp N6  &trans     &kp EXCLAMATION  &kp EQUAL         &kp MINUS       &kp FSLH      &kp SEMI
&kp UNDERSCORE  &kp N1  &kp N2  &kp N3  &kp SLASH  &kp PIPE         &kp GREATER_THAN  &kp UNDERSCORE  &kp PERCENT   &kp QUESTION
&trans          &trans  &trans  &trans  &trans     &trans           &trans            &trans          &trans        &trans
            >;
        };

        MOUSE {
            label = "mouse";
            bindings = <
&none   &none   &none   &none  &trans        &mkp MB1  &mkp MB2  &mkp MB3  &none   &trans
&none   &none   &none   &none  &trans        &mkp MB4  &mkp MB5  &none     &none   &trans
&none   &none   &none   &none  &trans        &none     &none     &none     &none   &trans
&trans  &trans  &trans  &none  &kp LEFT_GUI  &trans    &trans    &trans    &trans  &trans
            >;
        };

        BTandFUNCTION {
            bindings = <
&kp F9  &kp F10  &kp F11  &kp F12  &trans  &trans  &trans         &trans         &trans         &bt BT_CLR
&kp F5  &kp F6   &kp F7   &kp F8   &trans  &trans  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3
&kp F1  &kp F2   &kp F3   &kp F4   &trans  &trans  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_SEL 3
&trans  &trans   &trans   &trans   &trans  &trans  &trans         &trans         &trans         &trans
            >;

            label = "BT&FUNCTION";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        BTandFUNCTION {
            if-layers = <2 3>;
            then-layer = <5>;
        };
    };
};
